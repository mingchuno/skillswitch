{
  "name": "@mingchuno/skillswitch",
  "version": "0.3.0",
  "description": "Manage AI CLI skills across Claude Code, Gemini CLI, Codex CLI, Aider, Amp, and Factory Droid — profiles, disable/enable, catalog generation",
  "type": "module",
  "bin": {
    "skillswitch": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome ci .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "prepack": "pnpm build",
    "verify": "pnpm check && pnpm typecheck && pnpm build && pnpm test:coverage"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "tsup": "^8.0.0",
    "tsx": "4.22.0",
    "typescript": "^5.0.0",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "gemini",
    "codex",
    "aider",
    "amp",
    "skills",
    "ai",
    "cli",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingchuno/skillswitch.git"
  }
}
